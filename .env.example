# Skopiuj do Vercel → Settings → Environment Variables
# oraz lokalnie do .env (nie commituj sekretów)

# Supabase (https://supabase.com → New project)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # tylko serwer, NIE do frontu

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price ID z Stripe → Products (subskrypcje)
STRIPE_PRICE_PLUS_MONTH=price_...
STRIPE_PRICE_PLUS_YEAR=price_...

# Publiczny URL apki (bez slash na końcu)
VITE_APP_URL=https://zanim.com.pl
